# ---------------------------------------------------------------------------
# Patch Management Platform — environment template
# Copy to .env and fill in. .env is gitignored and NEVER committed.
# ---------------------------------------------------------------------------

# ---- Product infrastructure (root docker-compose.yml) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=patchmgmt
POSTGRES_USER=patchmgmt
POSTGRES_PASSWORD=change-me-in-.env

REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Database roles (Phase 1) ----
# The app connects as a RESTRICTED, non-owner role (patchmgmt_app) so RLS applies.
# Migrations run as the OWNER role (patchmgmt) via PATCHMGMT_MIGRATOR_CONNECTION.
# The 'App' connection string is what the API uses at runtime.
ConnectionStrings__App=Host=localhost;Port=5432;Database=patchmgmt;Username=patchmgmt_app;Password=patchmgmt_app_dev
PATCHMGMT_MIGRATOR_CONNECTION=Host=localhost;Port=5432;Database=patchmgmt;Username=patchmgmt;Password=patchmgmt

# ---- Credential vault (Phase 2) ----
# Master key custody. Default provider is 'software'.
# Providers: software | azure | aws | hashicorp
VAULT_KEY_PROVIDER=software
# Software provider KEK cold-start source: keyfile | operator | tpm
VAULT_SOFTWARE_KEK_SOURCE=keyfile
VAULT_SOFTWARE_KEK_FILE=./secrets/master.kek
# Allow an ABSENT key store to be initialized with a fresh KEK. FIRST BOOT ONLY — unset it again
# afterwards. A missing store is usually a lost mount or a wrong path, not a new install, and
# initializing in that case leaves every existing credential permanently unrecoverable.
VAULT_SOFTWARE_KEK_INIT=true

# ---- Lab fleet (see /lab/docker-compose.yml) ----
LAB_SSH_KEY_PATH=./lab/keys/lab_ed25519
LAB_SSH_USER=labadmin

# ---- App ----
ASPNETCORE_ENVIRONMENT=Development
