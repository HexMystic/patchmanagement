<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\Persistence\PatchManagement.Persistence.csproj" />
    <ProjectReference Include="..\..\Shared\Contracts\PatchManagement.Contracts.csproj" />
    <!-- Referenced so the DLL ships alongside the host: CompositionRoot discovers IModuleRegistrar
         by scanning PatchManagement.*.dll in the output directory, so a module the host never
         calls directly is still unreachable in production unless it is referenced here. -->
    <ProjectReference Include="..\..\Modules\Vault\PatchManagement.Vault.csproj" />
    <ProjectReference Include="..\..\Modules\Connectors\PatchManagement.Connectors.csproj" />
    <ProjectReference Include="..\..\Modules\Content\PatchManagement.Content.csproj" />
    <ProjectReference Include="..\..\Modules\Discovery\PatchManagement.Discovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
